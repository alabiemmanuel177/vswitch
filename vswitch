#!/usr/bin/env bash
set -euo pipefail

# Detect platform and set Vercel auth path
case "$(uname -s)" in
    Darwin)
        VERCEL_DIR="$HOME/Library/Application Support/com.vercel.cli"
        ;;
    Linux)
        if [ -n "${XDG_CONFIG_HOME:-}" ]; then
            VERCEL_DIR="$XDG_CONFIG_HOME/com.vercel.cli"
        else
            VERCEL_DIR="$HOME/.config/com.vercel.cli"
        fi
        ;;
    MINGW*|MSYS*|CYGWIN*)
        VERCEL_DIR="$APPDATA/com.vercel.cli"
        ;;
    *)
        echo "Unsupported platform: $(uname -s)"
        exit 1
        ;;
esac

AUTH_FILE="$VERCEL_DIR/auth.json"
PROFILES_DIR="$HOME/.vercel-profiles"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

mkdir -p "$PROFILES_DIR"

usage() {
    echo -e "${BOLD}vswitch${NC} - Vercel account switcher"
    echo ""
    echo -e "${BOLD}Usage:${NC}"
    echo "  vswitch save <name>      Save current login as a named profile"
    echo "  vswitch use <name>       Switch to a saved profile"
    echo "  vswitch list             List all saved profiles"
    echo "  vswitch current          Show the currently active profile"
    echo "  vswitch remove <name>    Remove a saved profile"
    echo "  vswitch login <name>     Login to Vercel and save as profile"
    echo ""
    echo -e "${BOLD}Examples:${NC}"
    echo "  vswitch save personal    # Save current auth as 'personal'"
    echo "  vswitch save work        # Save current auth as 'work'"
    echo "  vswitch use personal     # Switch to 'personal' account"
    echo "  vswitch login client-x   # Login fresh and save as 'client-x'"
}

get_active_profile() {
    if [ ! -f "$AUTH_FILE" ]; then
        echo ""
        return
    fi
    local current_token
    current_token=$(python3 -c "import json; print(json.load(open('$AUTH_FILE'))['token'])" 2>/dev/null || echo "")
    for profile in "$PROFILES_DIR"/*.json; do
        [ -f "$profile" ] || continue
        local profile_token
        profile_token=$(python3 -c "import json; print(json.load(open('$profile'))['token'])" 2>/dev/null || echo "")
        if [ "$current_token" = "$profile_token" ]; then
            basename "$profile" .json
            return
        fi
    done
    echo ""
}

cmd_save() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        echo -e "${RED}Error:${NC} Profile name required"
        echo "Usage: vswitch save <name>"
        exit 1
    fi

    if [ ! -f "$AUTH_FILE" ]; then
        echo -e "${RED}Error:${NC} No Vercel auth found. Run 'vercel login' first."
        exit 1
    fi

    # Get account info for display
    local email
    email=$(vercel whoami 2>/dev/null || echo "unknown")

    cp "$AUTH_FILE" "$PROFILES_DIR/$name.json"
    echo -e "${GREEN}Saved${NC} profile ${BOLD}$name${NC} ($email)"
}

cmd_use() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        echo -e "${RED}Error:${NC} Profile name required"
        echo "Usage: vswitch use <name>"
        exit 1
    fi

    local profile_file="$PROFILES_DIR/$name.json"
    if [ ! -f "$profile_file" ]; then
        echo -e "${RED}Error:${NC} Profile '${name}' not found"
        echo ""
        cmd_list
        exit 1
    fi

    cp "$profile_file" "$AUTH_FILE"
    local email
    email=$(vercel whoami 2>/dev/null || echo "unknown")
    echo -e "${GREEN}Switched${NC} to ${BOLD}$name${NC} ($email)"
}

cmd_list() {
    local active
    active=$(get_active_profile)
    local found=0

    echo -e "${BOLD}Saved profiles:${NC}"
    echo ""

    for profile in "$PROFILES_DIR"/*.json; do
        [ -f "$profile" ] || continue
        found=1
        local name
        name=$(basename "$profile" .json)
        if [ "$name" = "$active" ]; then
            echo -e "  ${GREEN}*${NC} ${BOLD}$name${NC} ${GREEN}(active)${NC}"
        else
            echo -e "    $name"
        fi
    done

    if [ "$found" -eq 0 ]; then
        echo -e "  ${DIM}No profiles saved yet.${NC}"
        echo ""
        echo "  Save your current login:"
        echo "    vswitch save <name>"
    fi
    echo ""
}

cmd_current() {
    local active
    active=$(get_active_profile)
    if [ -n "$active" ]; then
        local email
        email=$(vercel whoami 2>/dev/null || echo "unknown")
        echo -e "${BOLD}$active${NC} ($email)"
    else
        if [ -f "$AUTH_FILE" ]; then
            local email
            email=$(vercel whoami 2>/dev/null || echo "unknown")
            echo -e "${YELLOW}Logged in as${NC} $email ${DIM}(unsaved profile)${NC}"
        else
            echo -e "${DIM}Not logged in${NC}"
        fi
    fi
}

cmd_remove() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        echo -e "${RED}Error:${NC} Profile name required"
        echo "Usage: vswitch remove <name>"
        exit 1
    fi

    local profile_file="$PROFILES_DIR/$name.json"
    if [ ! -f "$profile_file" ]; then
        echo -e "${RED}Error:${NC} Profile '${name}' not found"
        exit 1
    fi

    rm "$profile_file"
    echo -e "${GREEN}Removed${NC} profile ${BOLD}$name${NC}"
}

cmd_login() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        echo -e "${RED}Error:${NC} Profile name required"
        echo "Usage: vswitch login <name>"
        exit 1
    fi

    echo -e "Logging in for profile ${BOLD}$name${NC}..."
    vercel login
    cp "$AUTH_FILE" "$PROFILES_DIR/$name.json"
    local email
    email=$(vercel whoami 2>/dev/null || echo "unknown")
    echo -e "${GREEN}Saved${NC} profile ${BOLD}$name${NC} ($email)"
}

# Main
case "${1:-}" in
    save)    cmd_save "${2:-}" ;;
    use|switch)  cmd_use "${2:-}" ;;
    list|ls) cmd_list ;;
    current) cmd_current ;;
    remove|rm) cmd_remove "${2:-}" ;;
    login)   cmd_login "${2:-}" ;;
    -h|--help|help) usage ;;
    "")      usage ;;
    *)
        # If just a name is passed, treat as "use"
        if [ -f "$PROFILES_DIR/$1.json" ]; then
            cmd_use "$1"
        else
            echo -e "${RED}Unknown command:${NC} $1"
            echo ""
            usage
            exit 1
        fi
        ;;
esac
